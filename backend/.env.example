# =========================
# SERVER / ENVIRONMENT
# =========================
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
# Uno o varios orígenes separados por coma
FRONTEND_URL=http://localhost:5173
APP_NAME=DrawCast
APP_FOLDER=
TRUST_PROXY=loopback

# =========================
# DATABASE (MySQL / MariaDB)
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fullstack_base
DB_USER=root
DB_PASS=

# =========================
# AUDIT DATABASE (OPTIONAL)
# =========================
# Si AUDIT_DB_NAME queda vacío, audit_logs e ip_cache usan la BD principal.
# Si lo defines, ambos modelos utilizan esta segunda conexión.
# AUDIT_DB_HOST / PORT / USER usan DB_* como fallback cuando se omiten.
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=3306
AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASS=

# =========================
# AUTH / SESSION
# =========================
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=15m
SESSION_EXPIRES_DAYS=30
SESSION_COOKIE_NAME=app_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Verificación OTP / dispositivos confiables
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_SECONDS=60
OTP_BCRYPT_ROUNDS=10
TRUSTED_DEVICE_DAYS=30
TRUSTED_DEVICE_COOKIE_NAME=trusted_device

# =========================
# GOOGLE OAUTH / IDENTITY
# =========================
GOOGLE_CLIENT_ID=

# =========================
# TWITCH OAUTH / IDENTITY
# Callback registrado en Twitch Developer Console, por ejemplo:
# http://localhost:3000/api/auth/twitch/callback
# =========================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# =========================
# KICK OAUTH / IDENTITY
# Kick uses OAuth 2.1 + PKCE.
# =========================
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback

# =========================
# DISCORD OAUTH / IDENTITY
# Public key is kept for future Discord interactions/webhooks; OAuth uses client ID/secret.
# =========================
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# =========================
# PASSWORD RECOVERY / EMAIL
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
PASSWORD_RESET_MINUTES=30

# =========================
# TECHNICAL LOGGING (WINSTON)
# =========================
LOG_LEVEL=info
LOG_DIR=logs

# =========================
# IP ENRICHMENT
# Provider supported: ipapi (https://ipapi.co)
# Leave IP_API_KEY empty to disable external enrichment.
# =========================
IP_PROVIDER=ipapi
IP_API_KEY=
IP_API_TIMEOUT_MS=1500
IP_CACHE_TTL_HOURS=168

# =========================
# SECURITY / RATE LIMITS
# =========================
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=12
OTP_RESEND_RATE_LIMIT_WINDOW_MS=900000
OTP_RESEND_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# =========================
# USER UPLOADS
# Local avatar storage. In production this directory can be mounted/persisted.
# Public URLs are served below APP_FOLDER/uploads.
# =========================
UPLOAD_DIR=uploads

# =========================
# OPTIONAL BOOTSTRAP USER
# =========================
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Protección adicional contra fuerza bruta por cuenta/identificador
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Cleanup: ejecuta `npm run cleanup` periódicamente (Task Scheduler/cron)
SECURITY_CLEANUP_RETENTION_DAYS=7

# CSRF / Origin protection
# Lista separada por comas si existen varios frontends autorizados.
CORS_ORIGINS=http://localhost:5173
# Mantener false para navegador. Activar sólo si deliberadamente usarás clientes
# no-browser (scripts/Postman/backend-to-backend) que no envían Origin/Referer.
ALLOW_ORIGINLESS_REQUESTS=false


# DrawCast Cloud
CHANNEL_SLEEP_MINUTES=10
UPLOAD_DIR=uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Diseños guardados
SAVED_DESIGN_LIMIT=100
SAVED_DESIGN_MAX_BYTES=8388608
JSON_BODY_LIMIT=10mb
SOCKET_MAX_BYTES=10000000

# Lienzos por usuario: fallback legacy hasta conectar enforcement de entitlements.
CANVAS_LIMIT_DEFAULT=3

# El seed de entitlements preserva cambios de negocio hechos en BD por defecto.
# Activa esto sólo cuando quieras reponer exactamente los defaults definidos en código.
ENTITLEMENT_SEED_OVERWRITE=false

# Cloudflare Turnstile
# La site key es pública; el secret sólo debe existir en backend.
CLOUDFLARE_CAPTCHA_KEY=
CLOUDFLARE_CAPTCHA_SECRET=
